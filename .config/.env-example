# Project Info

PROJECT=ien

# Enteprise CA certificate
# You may need this when running the container locally if your organization uses an https proxy

CA_CERTIFICATE_PATH=cert/ca.pem

# Application environment local/hosted

RUNTIME_ENV=local

# A bare `docker compose ...` defaults to docker-compose.yml, which is stale: it
# has no keycloak service and builds from the old Dockerfile that expects
# node_modules to come from your host. Nothing in CI uses it, and it is pending
# consolidation with docker-compose.local.yml and docker-compose.test.yaml.
# Until then, uncomment this so a bare `docker compose` runs the local stack
# instead of that file. Note it redirects `make docker-run` to the local stack too.
# COMPOSE_FILE=docker-compose.local.yml

# Database

POSTGRES_PASSWORD=Password
POSTGRES_HOST=localhost
POSTGRES_USERNAME=freshworks
POSTGRES_DATABASE=ien

# AWS and Terraform

CLOUDFRONT_ID=<VALUE>

EXPORT_SECRET=export

# MAIL

CHES_CLIENT_ID =
CHES_CLIENT_SECRET =
CHES_SERVICE_HOST =
CHES_AUTH_URL =

MAIL_FROM = IENDoNotReply@gov.bc.ca

# DB Tunnel

DB_HOST_DEV=RDS/Remote Database url
DB_HOST_PROD=
DB_HOST_TEST=
BASTION_INSTANCE_ID_DEV=EC2 instance id
BASTION_INSTANCE_ID_PROD=EC2 instance id
BASTION_INSTANCE_ID_TEST=EC2 instance id

# For testing teams alerts

TEAMS_ALERTS_WEBHOOK_URL=

# For Form Testing, set true to enable prefilled form

NEXT_PUBLIC_PREFILLED_FORM=false

# Import data from HMBC ATS system, These are mock data related URL and Key

HMBC_ATS_BASE_URL=https://api-uat.healthmatchbc.org/api/app
HMBC_ATS_AUTH_KEY=<Connect with backend developer if SSM param not set and get the API key>

# Keycloak variables
#
# Defaults below target the local Keycloak container in docker-compose.local.yml,
# which imports keycloak/realm-ien.json (realm "ien", client "IEN") on 8080.
# Leave no key blank: an empty value here still counts as "set" and defeats the
# Makefile's ?= fallbacks.

# local = run against the local backend and Keycloak. Keep the value on its own
# line; a trailing "# comment" becomes part of the value and breaks the
# Makefile's per-environment blocks.
ENV_NAME=local

# Read by the API when it verifies a token's signature against Keycloak's JWKS.
# This is the host-side value, used when the API runs as a local Node process
# (make watch / make start-local). When the API runs inside Docker,
# docker-compose.local.yml overrides it with the keycloak service name, because
# "localhost" there means the api container itself.
AUTH_URL=http://localhost:8080
AUTH_REALM=ien
AUTH_CLIENTID=IEN

# Seeded test users live in keycloak/realm-ien.json (ien_e2e, ien_hmbc, ien_moh, ...).
# Their real passwords are hashed in that file, so they cannot be used as-is. For local
# work, `make generate-local-realm` writes keycloak/realm-ien.generated.json giving every
# one of those users the password below; docker-compose.local.yml mounts that file. The
# generated file is gitignored, so this password never reaches the repo. Change it freely,
# then recreate Keycloak (make stop-local-keycloak && make start-local-keycloak).
KEYCLOAK_LOCAL_PASSWORD=local

# E2E_TEST_* are for cypress/pa11y against the test stack, which uses the committed realm
# file; in CI the password comes from a GitHub secret.
E2E_TEST_USERNAME=ien_e2e
E2E_TEST_PASSWORD=

# NEXT_PUBLIC_* are compiled into the browser bundle, so they are always
# addressed from your machine, never from inside the Docker network.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AUTH_REALM=ien
NEXT_PUBLIC_AUTH_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_CLIENTID=IEN

# if not set, the backend disables the endpoints of user-guides
DOCS_BUCKET=
# if set, the frontend hides the user-guide upload section
NEXT_PUBLIC_DISABLE_USER_GUIDE=false

# Turn off nestjs logger's cli-color
NO_COLOR=false
